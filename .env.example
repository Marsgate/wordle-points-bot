# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: register slash commands to one guild immediately (recommended while developing)
DISCORD_GUILD_ID=

# Optional: channel for server-wide notices (streak corrections, award
# announcements). Right-click the channel with Developer Mode on → Copy Channel ID.
# Leave empty to answer in the channel the summary came from, and to announce
# awards in the channel the command was used in.
DISCORD_WORDLE_CHANNEL_ID=

# Where the JSON store lives
DATA_DIR=./data

# Day boundary / "Wordle of the day" rollover
TZ=America/Indianapolis

# Developer tools: exposes /wordle-close and /wordle-reopen. Leave off for normal play.
DEBUG_TOOLS=false
